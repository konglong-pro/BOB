<Application x:Class="Bob.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#CBA6F7" />
        <SolidColorBrush x:Key="InkBrush" Color="#19141F" />
        <SolidColorBrush x:Key="MutedBrush" Color="#4B4054" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#32263B" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#D8B7FA" />
        <SolidColorBrush x:Key="ButtonBrush" Color="#F7F1FC" />

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CaretBrush" Value="{StaticResource InkBrush}" />
        </Style>
    </Application.Resources>
</Application>
