<Window x:Class="Bob.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BOB" Icon="Assets/BOB.ico" Width="1000" Height="780" Style="{StaticResource {x:Type Window}}"
        MinWidth="640" MinHeight="540" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnWindowKeyDown">
    <Window.Resources>
        <Style x:Key="HistoryTab" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="Padding" Value="4,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource ButtonBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/BOB.ico" Width="36" Height="36" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="BOB" FontSize="24" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Ellipse Width="7" Height="7" Fill="{Binding ConnectionBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ConnectionText}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Choose" Command="{Binding ChooseReceiveDirectoryCommand}" Padding="12,7"
                        ToolTip="Choose receive folder (Ctrl+Shift+R)" />
                <Button Content="Open" Command="{Binding OpenReceiveDirectoryCommand}" Padding="12,7" Margin="8,0,0,0"
                        ToolTip="Open receive folder (Ctrl+Shift+E)" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,4">
            <RadioButton Style="{StaticResource HistoryTab}" Content="Chat" Tag="Chat" IsChecked="True" Checked="OnHistoryFilterChanged" />
            <RadioButton Style="{StaticResource HistoryTab}" Content="Text" Tag="Text" Checked="OnHistoryFilterChanged" />
            <RadioButton Style="{StaticResource HistoryTab}" Content="Images" Tag="Images" Checked="OnHistoryFilterChanged" />
            <RadioButton Style="{StaticResource HistoryTab}" Content="Files" Tag="Files" Checked="OnHistoryFilterChanged" />
        </StackPanel>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Button Content="Load earlier records" Click="OnLoadEarlier" Padding="12,5" Margin="0,2,0,8"
                    HorizontalAlignment="Center" Visibility="{Binding EarlierHistoryVisibility}" />
            <TextBlock Grid.Row="1" Text="Your messages, images, and files appear here." HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Visibility="{Binding EmptyStateVisibility}" />
            <ListBox x:Name="TimelineList" Grid.Row="1" ItemsSource="{Binding HistoryView}" Background="Transparent"
                     BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.ScrollChanged="OnTimelineScrollChanged" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling" Padding="0,8">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,12" /><Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border HorizontalAlignment="{Binding Alignment}" MaxWidth="540" MinWidth="110" Padding="14,10"
                                Margin="3,0,12,0" Background="{Binding BubbleBrush}" BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="1" CornerRadius="4" Focusable="True" PreviewMouseDown="OnBubbleMouseDown">
                            <StackPanel>
                                <TextBlock Text="{Binding DirectionLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,4" />
                                <TextBox Text="{Binding DisplayedText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         Background="Transparent" BorderThickness="0" Padding="0" FontSize="15" Visibility="{Binding TextVisibility}"
                                         AutomationProperties.Name="Message text" />
                                <CheckBox Content="Expand / collapse text" IsChecked="{Binding IsExpanded}" Margin="0,6,0,0"
                                          Visibility="{Binding ExpandVisibility}" FontSize="11" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6" Visibility="{Binding ImageNameVisibility}" />
                                <Button Command="{Binding OpenFileCommand}" Visibility="{Binding FileVisibility}" Padding="8,6" Margin="0,2,0,6" ToolTip="Open local file">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                </Button>
                                <Button Padding="0" Margin="0,2,0,6" Background="Transparent" BorderThickness="0" Command="{Binding ViewImageCommand}"
                                        Visibility="{Binding ThumbnailVisibility}" AutomationProperties.Name="Open image" ToolTip="Open image · Right-click to copy">
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="Copy image" Command="{Binding CopyImageCommand}" InputGestureText="Ctrl+C" /></ContextMenu>
                                    </Button.ContextMenu>
                                    <Image Source="{Binding Thumbnail}" MaxWidth="480" MaxHeight="260" Stretch="Uniform" />
                                </Button>
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Visibility="{Binding DetailVisibility}"
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding TimeLabel}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text=" · " FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding Status}" MaxWidth="360" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <Border Grid.Row="4" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,6,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBox x:Name="Composer" Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}" MinHeight="64" MaxHeight="144"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" PreviewKeyDown="OnComposerKeyDown"
                         ToolTip="Enter to send · Shift+Enter for a new line" />
                <Grid Grid.Row="1" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Image" Command="{Binding ChooseImageCommand}" Padding="12,7" ToolTip="Send images (Ctrl+Shift+O)" />
                    <Button Grid.Column="1" Content="File" Command="{Binding ChooseFileCommand}" Padding="12,7" Margin="8,0,0,0" ToolTip="Send files (Ctrl+O)" />
                    <TextBlock Grid.Column="2" Text="{Binding ComposerHint}" TextWrapping="Wrap" FontSize="11" Margin="12,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    <Button Grid.Column="3" Content="Send" Command="{Binding SendTextCommand}" MinWidth="88" Padding="16,7" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
