<Window x:Class="Bob.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BOB" Icon="Assets/BOB.ico"
        Width="1080" Height="800" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" PreviewDragOver="OnDragOver" Drop="OnDrop">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SendTextCommand}" />
    </Window.InputBindings>
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/BOB.ico" Width="44" Height="44" Margin="0,0,16,0"
                   AutomationProperties.Name="BOB" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding ConversationTitle}" FontSize="28" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Ellipse Width="8" Height="8" Fill="{Binding ConnectionBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ConnectionText}" FontSize="13"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="BOB" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" />
                <TextBlock Text="PHONE + COMPUTER" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <Expander Grid.Row="1" Header="Connection &amp; receive folder"
                  Foreground="{StaticResource InkBrush}" FontSize="13">
            <Border Padding="16" Margin="0,8,0,0" BorderThickness="1.5"
                    BorderBrush="{StaticResource StrokeBrush}" Background="{StaticResource SurfaceBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding ConnectionDetail}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ServerDetails}" FontSize="12" Margin="0,4,0,12"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="Receive folder" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ReceiveDirectory}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ReceiveDirectory}"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding SettingsHint}" FontSize="12" Margin="0,4,0,0"
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                        <Button Content="Choose folder" Command="{Binding ChooseReceiveDirectoryCommand}"
                                AutomationProperties.Name="Choose receive folder" />
                        <Button Content="Open folder" Command="{Binding OpenReceiveDirectoryCommand}"
                                Margin="0,8,0,0" AutomationProperties.Name="Open receive folder" />
                    </StackPanel>
                </Grid>
            </Border>
        </Expander>

        <Border Grid.Row="2" Margin="0,16" BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1.5" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CONVERSATION" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Column="1" Text="Latest 20 texts · file history" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" />
                </Grid>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding EmptyStateVisibility}">
                    <TextBlock Text="A conversation between your devices" FontSize="25"
                               FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="Write a message, or drop images and files here."
                               Margin="0,12,0,0" FontSize="14" HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="Your phone's replies appear on the left."
                               Margin="0,4,0,0" FontSize="13" HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <ListBox x:Name="TimelineList" Grid.Row="1" ItemsSource="{Binding Timeline}"
                         Background="Transparent" BorderThickness="0" Padding="16,8,16,16"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,16" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter HorizontalAlignment="Stretch" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border MaxWidth="640" Padding="16,12" CornerRadius="4"
                                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Setter Property="Margin" Value="0,0,72,0" />
                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Outgoing}" Value="True">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="Margin" Value="72,0,0,0" />
                                                <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding DirectionLabel}" FontSize="10"
                                               FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding DisplayText}" Margin="0,8,0,8"
                                               TextWrapping="Wrap" FontSize="15" />
                                    <Button Padding="0" MinWidth="200" MinHeight="100" Margin="0,0,0,8"
                                            Command="{Binding ViewImageCommand}"
                                            Visibility="{Binding ThumbnailVisibility}"
                                            AutomationProperties.Name="View image preview" ToolTip="View image">
                                        <Image Source="{Binding Thumbnail}" MaxWidth="520" MaxHeight="240" Stretch="Uniform" />
                                    </Button>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"
                                               Visibility="{Binding DetailVisibility}" Margin="0,0,0,8"
                                               Foreground="{StaticResource MutedBrush}" />
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"
                                                 Height="6" Margin="0,0,0,6"
                                                 Foreground="{StaticResource InkBrush}" Background="{StaticResource CanvasBrush}"
                                                 IsIndeterminate="{Binding ProgressIndeterminate}"
                                                 Visibility="{Binding ProgressVisibility}"
                                                 AutomationProperties.Name="File transfer progress" />
                                    <TextBlock Text="{Binding RateLabel}" Visibility="{Binding RateVisibility}"
                                               Margin="0,0,0,4" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}" />
                                    <WrapPanel Margin="0,4,0,8">
                                        <Button Content="{Binding TextExpansionLabel}" Padding="10,5" Margin="0,0,8,4"
                                                Command="{Binding ExpandTextCommand}"
                                                Visibility="{Binding TextExpansionVisibility}" />
                                        <Button Content="Copy text" Padding="10,5" Margin="0,0,8,4"
                                                Command="{Binding CopyTextCommand}"
                                                Visibility="{Binding CopyTextVisibility}"
                                                AutomationProperties.Name="Copy full text" />
                                        <Button Content="View" Padding="10,5" Margin="0,0,8,4"
                                                Command="{Binding ViewImageCommand}" Visibility="{Binding ViewImageVisibility}"
                                                AutomationProperties.Name="View full image preview" />
                                        <Button Content="Copy image" Padding="10,5" Margin="0,0,8,4"
                                                Command="{Binding CopyImageCommand}" Visibility="{Binding CopyImageVisibility}" />
                                        <Button Content="Open file" Padding="10,5" Margin="0,0,8,4"
                                                Command="{Binding OpenFileCommand}" Visibility="{Binding OpenFileVisibility}" />
                                        <Button Content="Cancel" Padding="10,5" Margin="0,0,8,4"
                                                Command="{Binding CancelCommand}" Visibility="{Binding CancelVisibility}" />
                                        <Button Content="Retry" Padding="10,5" Margin="0,0,8,4"
                                                Command="{Binding RetryCommand}" Visibility="{Binding RetryVisibility}" />
                                    </WrapPanel>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="{Binding TimeLabel}" FontSize="11" Margin="0,0,12,0"
                                                   Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap"
                                                   TextAlignment="Right" Foreground="{StaticResource MutedBrush}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button x:Name="LatestButton" Grid.Row="1" Content="Jump to latest" Visibility="Collapsed"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16"
                        Click="OnLatestClick" AutomationProperties.Name="Jump to latest message" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Padding="16" CornerRadius="4" BorderThickness="1.5"
                BorderBrush="{StaticResource StrokeBrush}" Background="{StaticResource ButtonBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="48" MaxHeight="144" Padding="0,0,0,8" BorderThickness="0"
                         Background="Transparent" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Message to your phone"
                         ToolTip="Write a message. Ctrl+Enter sends; Enter adds a line." />
                <TextBlock Text="Message your phone..." IsHitTestVisible="False"
                           Visibility="{Binding DraftPlaceholderVisibility}"
                           Foreground="{StaticResource MutedBrush}" FontSize="14" />
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Images" Command="{Binding ChooseImageCommand}"
                            ToolTip="Choose one or more images" />
                    <Button Grid.Column="1" Content="Files" Command="{Binding ChooseFileCommand}"
                            Margin="8,0,0,0" ToolTip="Choose one or more files" />
                    <Button Grid.Column="3" Content="Send" MinWidth="96" Command="{Binding SendTextCommand}" />
                </Grid>
                <TextBlock Grid.Row="2" Text="{Binding ComposerHint}" FontSize="11" Margin="0,10,0,0"
                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
