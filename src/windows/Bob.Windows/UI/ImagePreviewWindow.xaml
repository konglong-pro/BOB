<Window x:Class="Bob.Windows.UI.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BOB · Image preview"
        Width="920"
        Height="720"
        MinWidth="520"
        MinHeight="420"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Image preview"
                       FontSize="24"
                       FontWeight="Bold" />
            <TextBlock x:Name="PreviewName"
                       Margin="0,4,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="13"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,16"
                Padding="12"
                Background="{StaticResource InkBrush}"
                BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="2"
                CornerRadius="2">
            <Image x:Name="PreviewImage"
                   Stretch="Uniform" />
        </Border>

        <Button Grid.Row="2"
                MinWidth="100"
                HorizontalAlignment="Right"
                Content="Close"
                IsCancel="True" />
    </Grid>
</Window>
