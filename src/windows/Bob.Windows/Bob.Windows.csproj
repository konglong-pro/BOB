<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BOB</AssemblyName>
    <RootNamespace>Bob.Windows</RootNamespace>
    <ApplicationIcon>Assets\BOB.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bob.Windows.Checks" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\BOB.ico" />
  </ItemGroup>
</Project>
